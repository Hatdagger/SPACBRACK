<?xml version="1.0" encoding="UTF-8"?>
<project>
  <name>SPACBRACK</name>
  <version>1.0.0</version>
  <platform>cd</platform>
  <makefile>Makefile</makefile>
  <neocorePath>..\neocore</neocorePath>
  <buildPath>..\build</buildPath>
  <distPath>..\dist</distPath>
  <gfx>
    <DAT>
      <chardata>
        <!-- DO NOT EDIT : setup -->
        <setup>
          <starting_tile>256</starting_tile>
          <charfile>out\char.bin</charfile>
          <mapfile>out\charMaps.s</mapfile>
          <palfile>out\charPals.s</palfile>
          <incfile>out\charInclude.h</incfile>
          <incprefix>../</incprefix>
        </setup>
        <pict id="tt_bg">
          <file>assets\gfx\bg.png</file>
        </pict>
        <pict id="tt_glyphs">
          <file>assets\gfx\glyphs.png</file>
        </pict>
        <pict id="tt_cards">
          <file>assets\gfx\cards.png</file>
        </pict>
      </chardata>
      <fixdata>
        <chardata>
          <!-- DO NOT EDIT : setup -->
          <setup fileType="fix">
            <charfile>out\fix.bin</charfile>
            <palfile>out\fixPals.s</palfile>
            <incfile>out\fixData.h</incfile>
          </setup>
          <import bank="0">
            <file>{{build}}\fix\systemFont.bin</file>
          </import>
          <!-- The next free bank is bank 3 -->
          <fix bank="3" id="tt_fix">
            <file>assets\gfx\fix\tiles.png</file>
          </fix>
        </chardata>
      </fixdata>
    </DAT>
  </gfx>
  <!-- Audio, made by tools/make_audio.py.
  Track ID 1 is reserved for the binary program; songs are tracks 2-6.
  spac.pcm / spac.z80 are the sound effects and their Z80 driver. -->
  <sound>
    <cd>
      <sfx>
        <pcm>assets\sounds\spac.pcm</pcm>
        <z80>assets\sounds\spac.z80</z80>
      </sfx>
      <cdda>
        <dist>
          <iso>
            <format>wav</format>
          </iso>
        </dist>
        <tracks>
          <track>
            <id>2</id>
            <file>assets\cdda\track02_title.wav</file>
            <pregap>00:02:00</pregap>
          </track>
          <track>
            <id>3</id>
            <file>assets\cdda\track03_marathon.wav</file>
            <pregap>00:02:00</pregap>
          </track>
          <track>
            <id>4</id>
            <file>assets\cdda\track04_sprint.wav</file>
            <pregap>00:02:00</pregap>
          </track>
          <track>
            <id>5</id>
            <file>assets\cdda\track05_versus.wav</file>
            <pregap>00:02:00</pregap>
          </track>
          <track>
            <id>6</id>
            <file>assets\cdda\track06_survival.wav</file>
            <pregap>00:02:00</pregap>
          </track>
        </tracks>
      </cdda>
    </cd>
  </sound>
  <emulator>
    <raine>
        <!-- DO NOT EDIT: This exeFile path is automatically maintained by NeoCore -->
      <exeFile>{{build}}\raine\raine.exe</exeFile>
      <config>
        <!-- To use a named config, use mak run:raine:<configName>.
        Example: mak run:raine:full to run RAINE in fullscreen.
        You can add more custom configs. -->
        <default>{{build}}\raine\config\default.cfg</default>
        <full>{{build}}\raine\config\fullscreen.cfg</full>
      </config>
    </raine>
    <mame>
      <exeFile>{{build}}\mame\mame64.exe</exeFile>
      <profile>
        <!-- To use a named profile, use mak run:mame:<profileName>.
        Example: mak run:mame:full to run MAME in fullscreen.
        You can add more custom profiles. -->
        <default>-window -skip_gameinfo neocdz</default>
        <full>-nowindow -skip_gameinfo neocdz</full>
        <nosound>-sound none -window -skip_gameinfo neocdz</nosound>
        <!-- DO NOT EDIT: This debug profile is automatically maintained by NeoCore -->
        <debug>-console -debug -window -skip_gameinfo -pluginspath {{build}}\mame\plugins -plugin ngdev neocdz</debug>
      </profile>
    </mame>
  </emulator>
  <compiler>
    <path>{{build}}\gcc\gcc-2.95.2</path>
    <includePath>{{neocore}}\src-lib\include</includePath>
    <libraryPath>{{build}}\lib</libraryPath>
    <crtPath>{{neocore}}\src-lib\crt</crtPath>
    <systemFile>
      <cd>{{neocore}}\src-lib\system\neocd.x</cd>
      <cartridge>{{neocore}}\src-lib\system\neocart.x</cartridge>
    </systemFile>
  </compiler>
</project>